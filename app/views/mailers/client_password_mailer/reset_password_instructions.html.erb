<%# Tudo sai do contato e do token - nada aqui e guardado uma segunda vez so
    para compor a mensagem. %>
<p><%= t('.greeting', name: @contact.name) %></p>

<p><%= t('.intro') %></p>

<%# A URL vem do helper que TODO e-mail do sistema usa (`root_url` +
    `default_url_options[:host]`, que em producao sai de FRONTEND_URL). Montar
    a mao aqui daria uma segunda regra para o mesmo endereco - e, com a variavel
    vazia, um link relativo que nao abre de dentro do e-mail. %>
<% url = frontend_url('client/password/edit', token: @token) %>

<p>
  <a href="<%= url %>"><%= t('.action') %></a>
</p>

<%# O link tambem em texto: cliente de e-mail que nao renderiza HTML, ou que
    bloqueia o clique, deixa a pessoa sem saida se o endereco nao aparecer. %>
<p><%= t('.fallback') %><br /><%= url %></p>

<p><%= t('.expires_in', hours: @validade_em_horas) %></p>

<p><%= t('.ignore') %></p>

<p><%= t('.regards') %></p>
