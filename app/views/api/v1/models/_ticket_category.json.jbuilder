json.id resource.id
json.name resource.name
json.position resource.position
json.team_id resource.team_id
# Exige anexo na abertura? Vai no payload porque os DOIS formularios - o do
# agente e o da Area do Cliente - precisam pedir o arquivo antes de enviar.
json.require_attachment resource.require_attachment
# Aparece no select da Area do Cliente? So a tela de Configuracoes usa isso - o
# formulario do agente mostra todas as Categorias da Mesa.
json.client_visible resource.client_visible
