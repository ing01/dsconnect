<%
  brand_name = global_config['BRAND_NAME'] || 'DueSoft'
  recipient_name = @resource.name.presence || @resource.email
  account_user = @resource&.account_users&.first
  inviter = account_user&.inviter
  account_name = account_user&.account&.name
  invited_user = inviter.present? && @resource.unconfirmed_email.blank?

  eyebrow = t('.welcome.eyebrow')
  heading = t('.welcome.heading')
  intro_text = t('.welcome.intro', brand: brand_name)
  supporting_text = t('.welcome.supporting')
  action_text = t('.welcome.action')
  action_url = frontend_url('auth/confirmation', confirmation_token: @token)
  info_title = nil
  info_text = nil
  detail_rows = []
  detail_rows << [t('.labels.new_email'), @resource.unconfirmed_email] if @resource.unconfirmed_email.present?

  if @resource.unconfirmed_email.present?
    eyebrow = t('.email_update.eyebrow')
    heading = t('.email_update.heading')
    intro_text = t('.email_update.intro', brand: brand_name)
    supporting_text = t('.email_update.supporting')
    action_text = t('.email_update.action')
  elsif @resource.confirmed?
    eyebrow = t('.ready.eyebrow')
    heading = t('.ready.heading')
    intro_text = t('.ready.intro', brand: brand_name)
    supporting_text = t('.ready.supporting')
    action_text = t('.ready.action')
    action_url = frontend_url('auth/sign_in')
    detail_rows = []
  elsif invited_user
    eyebrow = t('.invite.eyebrow')
    heading = account_name.present? ? t('.invite.heading_account', account: account_name) : t('.invite.heading_brand', brand: brand_name)
    intro_text = if account_name.present?
      t('.invite.intro_account', inviter: inviter.name, account: account_name, brand: brand_name)
    else
      t('.invite.intro_brand', inviter: inviter.name, brand: brand_name)
    end
    supporting_text = t('.invite.supporting')
    action_text = t('.invite.action')
    action_url = frontend_url(
      'auth/password/edit',
      reset_password_token: @resource.send(:set_reset_password_token)
    )
    detail_rows = [[t('.labels.invited_by'), inviter.name]]
    detail_rows << [t('.labels.workspace'), account_name] if account_name.present?
  end
%>

<%= render partial: 'devise/mailer/confirmation_body', locals: {
  action_text: action_text,
  action_url: action_url,
  detail_rows: detail_rows,
  eyebrow: eyebrow,
  heading: heading,
  info_text: info_text,
  info_title: info_title,
  intro_text: intro_text,
  recipient_name: recipient_name,
  supporting_text: supporting_text
} %>
